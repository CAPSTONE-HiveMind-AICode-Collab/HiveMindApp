rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for authentication and authorization
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserId() {
      return request.auth.uid;
    }
    
    function isHiveMember(hiveID) {
      return isSignedIn() && getUserId() in get(/databases/$(database)/documents/Hive/$(hiveID)).data.members;
    }
    
    function isHiveOwner(hiveID) {
      return isSignedIn() && getUserId() == get(/databases/$(database)/documents/Hive/$(hiveID)).data.ownerId;
    }
    
    function getUserRole(hiveID) {
      return get(/databases/$(database)/documents/Hive/$(hiveID)/members/$(getUserId())).data.role;
    }
    
    function hasRole(hiveID, allowedRoles) {
      return isHiveMember(hiveID) && getUserRole(hiveID) in allowedRoles;
    }
    
    // Validate data types and required fields
    function isValidHive(data) {
      return data.keys().hasAll(['name', 'ownerId', 'members', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.ownerId is string
        && data.members is list
        && data.createdAt is timestamp;
    }
    
    function isValidHoneycomb(data) {
      return data.keys().hasAll(['name', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.createdAt is timestamp;
    }
    
    function isValidMessage(data) {
      return data.keys().hasAll(['text', 'sender', 'senderId', 'timestamp'])
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 10000  // Max message length
        && data.sender is string
        && data.senderId is string
        && data.timestamp is timestamp;
    }
    
    // Rate limiting helper (prevent spam)
    function notTooManyRequests() {
      // Allow max 100 writes per minute (simplified, real rate limiting needs backend)
      return true; // Placeholder - implement with Cloud Functions for real rate limiting
    }
    
    // ==================== HIVE RULES ====================
    match /Hive/{hiveID} {
      // Anyone authenticated can create a hive
      allow create: if isSignedIn() 
        && isValidHive(request.resource.data)
        && request.resource.data.ownerId == getUserId()
        && getUserId() in request.resource.data.members
        && notTooManyRequests();
      
      // Members can read their hives
      allow read: if isHiveMember(hiveID);
      
      // Only owner can update hive (change name, add/remove members)
      allow update: if isHiveOwner(hiveID)
        && isValidHive(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId; // Can't change owner
      
      // Only owner can delete hive
      allow delete: if isHiveOwner(hiveID);
      
      // ==================== HIVE MEMBERS SUBCOLLECTION ====================
      match /members/{memberID} {
        // Members can read member list
        allow read: if isHiveMember(hiveID);
        
        // Owner and admins can add/update members
        allow create, update: if hasRole(hiveID, ['OWNER', 'ADMIN'])
          && request.resource.data.keys().hasAll(['role', 'displayName', 'email'])
          && request.resource.data.role in ['OWNER', 'ADMIN', 'MEMBER', 'VIEWER'];
        
        // Only owner can delete members (or user can delete themselves)
        allow delete: if isHiveOwner(hiveID) || memberID == getUserId();
      }
      
      // ==================== USER STATUS SUBCOLLECTION ====================
      match /userStatus/{userID} {
        // Users can read/write their own status
        allow read, write: if isSignedIn() && userID == getUserId();
      }
      
      // ==================== HONEYCOMB RULES ====================
      match /Honeycomb/{honeycombID} {
        // Owner and admins can create honeycombs
        allow create: if hasRole(hiveID, ['OWNER', 'ADMIN'])
          && isValidHoneycomb(request.resource.data);
        
        // Members can read honeycombs
        allow read: if isHiveMember(hiveID);
        
        // Owner and admins can update honeycombs
        allow update: if hasRole(hiveID, ['OWNER', 'ADMIN'])
          && isValidHoneycomb(request.resource.data);
        
        // Only owner can delete honeycombs
        allow delete: if isHiveOwner(hiveID);
        
        // ==================== HONEYCOMB USER STATUS ====================
        match /userStatus/{userID} {
          allow read, write: if isSignedIn() && userID == getUserId();
        }
        
        // ==================== MESSAGE RULES ====================
        match /messages/{messageID} {
          // Members (not viewers) can create messages
          allow create: if hasRole(hiveID, ['OWNER', 'ADMIN', 'MEMBER'])
            && isValidMessage(request.resource.data)
            && request.resource.data.senderId == getUserId()
            && notTooManyRequests();
          
          // Members can read messages
          allow read: if isHiveMember(hiveID);
          
          // Users can update their own messages (edit)
          allow update: if isSignedIn() 
            && resource.data.senderId == getUserId()
            && isValidMessage(request.resource.data);
          
          // Users can delete their own messages, or owner can delete any
          allow delete: if (isSignedIn() && resource.data.senderId == getUserId())
            || isHiveOwner(hiveID);
          
          // ==================== MESSAGE USER STATUS ====================
          match /userStatus/{userID} {
            allow read, write: if isSignedIn() && userID == getUserId();
          }
          
          // ==================== THREAD RULES ====================
          match /Threads/{threadID} {
            // Members can create threads
            allow create: if hasRole(hiveID, ['OWNER', 'ADMIN', 'MEMBER'])
              && isValidMessage(request.resource.data)
              && request.resource.data.senderId == getUserId();
            
            // Members can read threads
            allow read: if isHiveMember(hiveID);
            
            // Users can update their own thread messages, or close threads
            allow update: if isSignedIn() 
              && (resource.data.senderId == getUserId() 
                  || hasRole(hiveID, ['OWNER', 'ADMIN', 'MEMBER']));
            
            // Users can delete their own thread messages, or owner can delete
            allow delete: if (isSignedIn() && resource.data.senderId == getUserId())
              || isHiveOwner(hiveID);
            
            // Thread user status
            match /userStatus/{userID} {
              allow read, write: if isSignedIn() && userID == getUserId();
            }
          }
        }
        
        // ==================== SUMMARY RULES ====================
        match /summaries/{summaryID} {
          // Only backend (AI) can create summaries
          // In practice, use Cloud Functions with admin SDK
          allow create: if hasRole(hiveID, ['OWNER', 'ADMIN', 'MEMBER']);
          
          // Members can read summaries
          allow read: if isHiveMember(hiveID);
          
          // No updates or deletes (summaries are immutable)
          allow update: if false;
          allow delete: if isHiveOwner(hiveID);
        }
      }
    }
    
    // ==================== AUDIT LOG RULES ====================
    // Security audit logs (read-only for users, write from Cloud Functions)
    match /auditLogs/{logID} {
      allow read: if isSignedIn(); // Users can see logs related to them
      allow write: if false; // Only Cloud Functions can write logs
    }
    
    // ==================== ANALYTICS RULES ====================
    // Usage analytics (admin only)
    match /analytics/{docID} {
      allow read: if false; // Access via Cloud Functions/Admin SDK only
      allow write: if false;
    }
  }
}
